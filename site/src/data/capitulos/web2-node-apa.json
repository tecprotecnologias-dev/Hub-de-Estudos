{
 "numero": null,
 "titulo": "Referência Rápida",
 "blocos": [
  {
   "t": "h2",
   "id": "introducao",
   "texto": "Introdução"
  },
  {
   "t": "p",
   "html": "Esta seção reúne, em poucas páginas, os comandos e conceitos mais usados ao longo do livro – pensada para consulta rápida, não para leitura sequencial."
  },
  {
   "t": "h2",
   "id": "comandos-sql-capitulo-6",
   "texto": "Comandos SQL (Capítulo 6)"
  },
  {
   "t": "tabela",
   "cabecalho": [
    "Comando",
    "Finalidade"
   ],
   "linhas": [
    [
     "<code>CREATE DATABASE nome;</code>",
     "Cria um banco de dados"
    ],
    [
     "<code>USE nome;</code>",
     "Seleciona o banco ativo"
    ],
    [
     "<code>CREATE TABLE t (...);</code>",
     "Cria uma tabela"
    ],
    [
     "<code>ALTER TABLE t ADD col tipo;</code>",
     "Adiciona uma coluna"
    ],
    [
     "<code>DESCRIBE tabela;</code>",
     "Mostra a estrutura de uma tabela"
    ],
    [
     "<code>SELECT * FROM t;</code>",
     "Consulta todos os registros"
    ],
    [
     "<code>SELECT col FROM t WHERE cond;</code>",
     "Consulta com filtro"
    ],
    [
     "<code>INSERT INTO t (c) VALUES (v);</code>",
     "Insere um registro"
    ],
    [
     "<code>UPDATE t SET c = v WHERE cond;</code>",
     "Atualiza registros"
    ],
    [
     "<code>DELETE FROM t WHERE cond;</code>",
     "Remove registros"
    ],
    [
     "<code>ORDER BY col ASC|DESC</code>",
     "Ordena resultados"
    ],
    [
     "<code>LIMIT n OFFSET m</code>",
     "Pagina resultados"
    ],
    [
     "<code>GROUP BY col</code>",
     "Agrupa registros"
    ],
    [
     "<code>JOIN t2 ON t.id = t2.ref</code>",
     "Combina tabelas relacionadas"
    ]
   ]
  },
  {

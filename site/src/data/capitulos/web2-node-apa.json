  {
   "t": "h2",
   "id": "comandos-npm-capitulos-2-e-5",
   "texto": "Comandos npm (Capítulos 2 e 5)"
  },
  {
   "t": "tabela",
   "cabecalho": [
    "Comando",
    "Finalidade"
   ],
   "linhas": [
    [
     "<code>npm init -y</code>",
     "Cria o <code>package.json</code>"
    ],
    [
     "<code>npm install pacote</code>",
     "Instala uma dependência"
    ],
    [
     "<code>npm install pacote --save-dev</code>",
     "Instala como dependência de desenvolvimento"
    ],
    [
     "<code>npm uninstall pacote</code>",
     "Remove uma dependência"
    ],
    [
     "<code>npm update pacote</code>",
     "Atualiza uma dependência"
    ],
    [
     "<code>npm outdated</code>",
     "Lista dependências desatualizadas"
    ],
    [
     "<code>npm run script</code>",
     "Executa um script do <code>package.json</code>"
    ],
    [
     "<code>npm start</code>",
     "Executa o script <code>start</code>"
    ],
    [
     "<code>node --watch arquivo.js</code>",
     "Reinicia o programa a cada arquivo salvo (sem nodemon)"
    ]
   ]
  },

# Copie este arquivo para .env.local e preencha com os dados do seu projeto no Supabase
# (painel do Supabase > Project Settings > API). O .env.local não vai para o GitHub.
# Sem esses valores, o site funciona aberto, sem cadastro nem login.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public
